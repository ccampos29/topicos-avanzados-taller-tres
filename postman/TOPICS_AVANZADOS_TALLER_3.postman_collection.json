		{
			"name": "Apod",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Función para verificar si una fecha está en formato YYYY-MM-DD\r",
							"function isValidDate(dateString) {\r",
							"    const regex = /^\\d{4}-\\d{2}-\\d{2}$/;\r",
							"    return regex.test(dateString);\r",
							"}\r",
							"\r",
							"// Obtener la fecha de hoy en formato YYYY-MM-DD\r",
							"const today = new Date().toISOString().split('T')[0];\r",
							"\r",
							"// Validar el parámetro 'date'\r",
							"if (pm.request.url.query.has('date')) {\r",
							"    const date = pm.request.url.query.get('date');\r",
							"    if (!isValidDate(date)) {\r",
							"        throw new Error(`La fecha ${date} no está en formato válido. Usa YYYY-MM-DD.`);\r",
							"    }\r",
							"} else if (!pm.request.url.query.has('count')) {\r",
							"    // Si no se ha definido 'date' ni 'count', usar la fecha de hoy por defecto\r",
							"    pm.request.url.query.add({\r",
							"        key: 'date',\r",
							"        value: today\r",
							"    });\r",
							"} \r",
							"\r",
							"// Validar los parámetros 'start_date' y 'end_date'\r",
							"if (pm.request.url.query.has('start_date')) {\r",
							"    const startDate = pm.request.url.query.get('start_date');\r",
							"    if (!isValidDate(startDate)) {\r",
							"        throw new Error(`La fecha ${startDate} no está en formato válido. Usa YYYY-MM-DD.`);\r",
							"    }\r",
							"}\r",
							"\r",
							"if (pm.request.url.query.has('end_date')) {\r",
							"    const endDate = pm.request.url.query.get('end_date');\r",
							"    if (!isValidDate(endDate)) {\r",
							"        throw new Error(`La fecha ${endDate} no está en formato válido. Usa YYYY-MM-DD.`);\r",
							"    }\r",
							"}\r",
							"\r",
							"// Validar que 'count' no se use con 'date' o un rango de fechas\r",
							"if (pm.request.url.query.has('count')) {\r",
							"    if (pm.request.url.query.has('date')) {\r",
							"        throw new Error(\"'count' no se puede usar junto con 'date'. Elimina uno de los parámetros.\");\r",
							"    }\r",
							"\r",
							"    if (pm.request.url.query.has('start_date') || pm.request.url.query.has('end_date')) {\r",
							"        throw new Error(\"'count' no se puede usar junto con 'start_date' o 'end_date'. Elimina uno de los parámetros.\");\r",
							"    }\r",
							"\r",
							"    // Obtener el valor ingresado para 'count'\r",
							"    const countValue = pm.request.url.query.get('count');\r",
							"    pm.request.url.query.upsert({\r",
							"        key: 'count',\r",
							"        value: countValue\r",
							"    });\r",
							"}\r",
							"\r",
							"if (!pm.request.url.query.has('api_key')) {\r",
							"    const currentEnvironment = pm.environment.name;\r",
							"    console.log('CURRENT ENVIRONMENT: ', currentEnvironment)\r",
							"\r",
							"    // Comprobar si el entorno es ENV_TESTS\r",
							"    if (currentEnvironment === 'ENV_TESTS') {\r",
							"        const apiKey = pm.environment.get('API_KEY');\r",
							"\r",
							"        if (apiKey) {\r",
							"            pm.request.url.query.add({\r",
							"                key: 'api_key',\r",
							"                value: apiKey\r",
							"            });\r",
							"        } else {\r",
							"            throw new Error(\"API_KEY no está definida en el entorno ENV_TEST.\");\r",
							"        }\r",
							"    } else {\r",
							"        // Usar una API key por defecto para otros entornos\r",
							"        pm.request.url.query.add({\r",
							"            key: 'api_key',\r",
							"            value: 'uUf90MvbwKZz9HvDXQGWdpI5CCjEqethNtFauWcv'\r",
							"        });\r",
							"    }\r",
							"}\r",
							"\r",
							"// Mostrar los parámetros actuales en la consola para depuración\r",
							"console.log('Parámetros actuales:', pm.request.url.query.toObject());\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Suponiendo que ya tienes la respuesta guardada en una variable llamada `response`\r",
							"pm.test(\"El código de estado es 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Guardar los resultados en una variable\r",
							"const results = pm.response.json();\r",
							"\r",
							"// Verificar que la cantidad de resultados corresponda al count ingresado\r",
							"const count = pm.request.url.query.get('count');\r",
							"if (count) {\r",
							"    pm.test(`La cantidad de resultados es ${count}`, function () {\r",
							"        pm.expect(results.length).to.equal(parseInt(count));\r",
							"    });\r",
							"}\r",
							"\r",
							"// Verificar si se proporcionó 'date' y que la fecha esté presente\r",
							"const dateParam = pm.request.url.query.get('date');\r",
							"if (dateParam) {\r",
							"    pm.test(`La fecha ${dateParam} está presente en los resultados`, function () {\r",
							"        const dateExists = results.some(item => item.date === dateParam);\r",
							"        pm.expect(dateExists).to.be.true;\r",
							"    });\r",
							"\r",
							"    pm.test(\"La fecha proporcionada está en formato válido (YYYY-MM-DD)\", function () {\r",
							"        pm.expect(isValidDate(dateParam)).to.be.true;\r",
							"    });\r",
							"}\r",
							"\r",
							"// Verificar si se proporcionaron 'start_date' y 'end_date'\r",
							"const startDateParam = pm.request.url.query.get('start_date');\r",
							"const endDateParam = pm.request.url.query.get('end_date');\r",
							"\r",
							"if (startDateParam && endDateParam) {\r",
							"    pm.test(`Todos los resultados están dentro del rango de fechas de ${startDateParam} a ${endDateParam}`, function () {\r",
							"        const isInRange = results.every(item => {\r",
							"            const itemDate = new Date(item.date);\r",
							"            return itemDate >= new Date(startDateParam) && itemDate <= new Date(endDateParam);\r",
							"        });\r",
							"        pm.expect(isInRange).to.be.true;\r",
							"    });\r",
							"\r",
							"    pm.test(\"El rango de fechas tiene un formato válido (YYYY-MM-DD)\", function () {\r",
							"        pm.expect(isValidDate(startDateParam)).to.be.true;\r",
							"        pm.expect(isValidDate(endDateParam)).to.be.true;\r",
							"    });\r",
							"}\r",
							"\r",
							"// Verificar que todas las fechas estén en formato válido\r",
							"pm.test(\"Todas las fechas están en formato válido (YYYY-MM-DD)\", function () {\r",
							"    const areValidDates = results.every(item => isValidDate(item.date));\r",
							"    pm.expect(areValidDates).to.be.true;\r",
							"});\r",
							"\r",
							"// Verificar que cada resultado tenga un title y un explanation no vacíos\r",
							"pm.test(\"Cada resultado tiene un title y un explanation no vacíos\", function () {\r",
							"    const hasValidFields = results.every(item => item.title && item.explanation);\r",
							"    pm.expect(hasValidFields).to.be.true;\r",
							"});\r",
							"\r",
							"// Comprobar que todos los elementos de media_type sean de tipo esperado\r",
							"pm.test(\"Todos los media_type son de tipo esperado\", function () {\r",
							"    const validMediaTypes = ['image', 'video', 'other'];\r",
							"    const hasValidMediaType = results.every(item => validMediaTypes.includes(item.media_type));\r",
							"    pm.expect(hasValidMediaType).to.be.true;\r",
							"});\r",
							"\r",
							"// Función para verificar si una fecha está en formato YYYY-MM-DD\r",
							"function isValidDate(dateString) {\r",
							"    const regex = /^\\d{4}-\\d{2}-\\d{2}$/;\r",
							"    return regex.test(dateString);\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
