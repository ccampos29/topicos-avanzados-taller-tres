		{
			"name": "Neo - Lookup",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Obtener la variable de entorno NEO_REFERENCE_IDS\r",
							"let neoIdsString = pm.environment.get('NEO_REFERENCE_IDS');\r",
							"\r",
							"if (!neoIdsString) {\r",
							"    throw new Error(\"La variable de entorno NEO_REFERENCE_IDS no está definida.\");\r",
							"}\r",
							"\r",
							"// Convertir el string en un array de IDs\r",
							"let neoIdsArray = neoIdsString.split(',');\r",
							"\r",
							"// Obtener el índice actual desde otra variable de entorno (inicializa en 0 si no está definido)\r",
							"let currentIndex = parseInt(pm.environment.get('CURRENT_NEO_INDEX') || 0, 10);\r",
							"\r",
							"// Verificar si hemos procesado todos los IDs\r",
							"if (currentIndex >= neoIdsArray.length) {\r",
							"    pm.environment.unset('CURRENT_NEO_INDEX'); // Limpiar el índice si se ha procesado todo\r",
							"    throw new Error(\"Todos los NEO_REFERENCE_IDS han sido procesados.\");\r",
							"}\r",
							"\r",
							"// Obtener el ID actual\r",
							"let currentNeoId = neoIdsArray[currentIndex];\r",
							"\r",
							"// Construir la URL dinámica del servicio\r",
							"const apiKey = pm.environment.get('API_KEY');\r",
							"let newUrl = `https://api.nasa.gov/neo/rest/v1/neo/${currentNeoId}?api_key=${apiKey}`;\r",
							"\r",
							"// Establecer la nueva URL en la solicitud\r",
							"pm.request.url = newUrl;\r",
							"\r",
							"// Imprimir el ID actual y la URL generada en la consola para verificación\r",
							"console.log(\"Ejecutando para NEO_REFERENCE_ID:\", currentNeoId);\r",
							"console.log(\"Nueva URL:\", newUrl);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Verificar que el código de estado es 200\r",
							"pm.test(\"El código de estado es 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Obtener la respuesta JSON\r",
							"let responseJson = pm.response.json();\r",
							"\r",
							"// Verificar que el campo 'name' está presente en la respuesta\r",
							"pm.test(\"El campo 'name' está presente en la respuesta\", function () {\r",
							"    pm.expect(responseJson).to.have.property('name');\r",
							"});\r",
							"\r",
							"// Verificar que el campo 'absolute_magnitude_h' es un número\r",
							"pm.test(\"El campo 'absolute_magnitude_h' es un número\", function () {\r",
							"    pm.expect(responseJson).to.have.property('absolute_magnitude_h').that.is.a('number');\r",
							"});\r",
							"\r",
							"// Verificar que hay datos de 'close_approach_data'\r",
							"pm.test(\"La respuesta tiene datos de 'close_approach_data'\", function () {\r",
							"    pm.expect(responseJson).to.have.property('close_approach_data').that.is.an('array').with.length.greaterThan(0);\r",
							"});\r",
							"\r",
							"// Verificar que la velocidad relativa es mayor que 0 km/s\r",
							"pm.test(\"La velocidad relativa es mayor que 0 km/s\", function () {\r",
							"    let velocity = responseJson.close_approach_data[0].relative_velocity.kilometers_per_second;\r",
							"    pm.expect(parseFloat(velocity)).to.be.above(0);\r",
							"});\r",
							"\r",
							"// Obtener el índice actual\r",
							"let currentIndex = parseInt(pm.environment.get('CURRENT_NEO_INDEX') || 0, 10);\r",
							"\r",
							"// Obtener la variable de entorno NEO_REFERENCE_IDS\r",
							"let neoIdsString = pm.environment.get('NEO_REFERENCE_IDS');\r",
							"let neoIdsArray = neoIdsString ? neoIdsString.split(',') : [];\r",
							"\r",
							"// Incrementar el índice para la próxima solicitud\r",
							"pm.environment.set('CURRENT_NEO_INDEX', currentIndex + 1);\r",
							"\r",
							"// Verificar si hemos procesado todos los IDs\r",
							"if (currentIndex + 1 >= neoIdsArray.length) {\r",
							"    pm.environment.unset('CURRENT_NEO_INDEX');\r",
							"    pm.environment.unset('NEO_REFERENCE_IDS');\r",
							"    console.log(\"Todos los NEO_REFERENCE_IDS han sido procesados.\");\r",
							"} else {\r",
							"    // Si no hemos terminado, simplemente continuar\r",
							"    console.log(\"Continuando con el siguiente NEO_REFERENCE_ID...\");\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{BASE_URL}}",
					"host": [
						"{{BASE_URL}}"
					]
				}
			},
			"response": []
