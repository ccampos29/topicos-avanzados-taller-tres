		{
			"name": "Neo - Feed",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Función para validar formato de fecha YYYY-MM-DD\r",
							"function isValidDateFormat(date) {\r",
							"    const regex = /^\\d{4}-\\d{2}-\\d{2}$/; // Expresión regular para YYYY-MM-DD\r",
							"    return regex.test(date);\r",
							"}\r",
							"\r",
							"const startDate = pm.request.url.query.get('start_date');\r",
							"const endDate = pm.request.url.query.get('end_date');\r",
							"\r",
							"if (!pm.request.url.query.has('start_date')) {\r",
							"    throw new Error(\"El parámetro 'start_date' es obligatorio y no se ha proporcionado.\");\r",
							"} else if(!isValidDateFormat(startDate)){\r",
							"    throw new Error(\"Formato incorrecto para 'start_date' debe ser YYYY-MM-DD.\");    \r",
							"}\r",
							"\r",
							"if (!pm.request.url.query.has('end_date')) {\r",
							"    throw new Error(\"El parámetro 'end_date' es obligatorio y no se ha proporcionado.\");\r",
							"} else if(!isValidDateFormat(endDate)){\r",
							"    throw new Error(\"Formato incorrecto para 'end_date' debe ser YYYY-MM-DD.\");    \r",
							"}\r",
							"\r",
							"// Validar si end_date excede los 7 días desde start_date\r",
							"const startDateObj = new Date(startDate);\r",
							"const endDateObj = new Date(endDate);\r",
							"const maxEndDate = new Date(startDateObj);\r",
							"maxEndDate.setDate(maxEndDate.getDate() + 7);\r",
							"\r",
							"if (endDateObj > maxEndDate) {\r",
							"    throw new Error(\"El 'end_date' no puede ser mayor que 7 días después de 'start_date'.\");\r",
							"}\r",
							"\r",
							"// Validar que end_date no sea menor que start_date\r",
							"if (endDateObj < startDateObj) {\r",
							"    throw new Error(\"El 'end_date' no puede ser menor que 'start_date'.\");\r",
							"}\r",
							"\r",
							"// Validación del parámetro 'api_key'\r",
							"if (!pm.request.url.query.has('api_key')) {\r",
							"    const currentEnvironment = pm.environment.name;\r",
							"    console.log('CURRENT ENVIRONMENT: ', currentEnvironment)\r",
							"\r",
							"    // Comprobar si el entorno es ENV_TESTS\r",
							"    if (currentEnvironment === 'ENV_TESTS') {\r",
							"        const apiKey = pm.environment.get('API_KEY');\r",
							"\r",
							"        if (apiKey) {\r",
							"            pm.request.url.query.add({\r",
							"                key: 'api_key',\r",
							"                value: apiKey\r",
							"            });\r",
							"        } else {\r",
							"            throw new Error(\"API_KEY no está definida en el entorno ENV_TEST.\");\r",
							"        }\r",
							"    } else {\r",
							"        // Usar una API key por defecto para otros entornos\r",
							"        pm.request.url.query.add({\r",
							"            key: 'api_key',\r",
							"            value: 'uUf90MvbwKZz9HvDXQGWdpI5CCjEqethNtFauWcv'\r",
							"        });\r",
							"    }\r",
							"}\r",
							"\r",
							"// Mostrar los parámetros actuales en la consola para depuración\r",
							"console.log('Parámetros actuales:', pm.request.url.query.toObject());\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Validar que el código de estado sea 200\r",
							"pm.test(\"El código de estado es 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Validar que la respuesta esté en formato JSON\r",
							"pm.test(\"La respuesta es JSON\", function () {\r",
							"    pm.response.to.be.json;\r",
							"});\r",
							"\r",
							"// Obtener la respuesta JSON del servicio\r",
							"const response = pm.response.json();\r",
							"\r",
							"// Validar que la respuesta tenga el campo element_count y que sea un número\r",
							"pm.test(\"Element count es un número\", function () {\r",
							"    pm.expect(response.element_count).to.be.a('number');\r",
							"});\r",
							"\r",
							"// Validar que near_earth_objects no esté vacío\r",
							"pm.test(\"near_earth_objects tiene datos\", function () {\r",
							"    pm.expect(Object.keys(response.near_earth_objects).length).to.be.greaterThan(0);\r",
							"});\r",
							"\r",
							"// Array para almacenar los ids\r",
							"let neoIds = [];\r",
							"\r",
							"// Iterar sobre los objetos de near_earth_objects y validar que tengan neo_reference_id\r",
							"for (let date in response.near_earth_objects) {\r",
							"    let objects = response.near_earth_objects[date];\r",
							"    \r",
							"    // Iterar sobre cada objeto en el array\r",
							"    objects.forEach(neo => {\r",
							"        pm.test(\"El objeto tiene un neo_reference_id\", function () {\r",
							"            pm.expect(neo).to.have.property('neo_reference_id');\r",
							"        });\r",
							"        \r",
							"        // Añadir el neo_reference_id al array\r",
							"        neoIds.push(neo.neo_reference_id);\r",
							"    });\r",
							"}\r",
							"\r",
							"// Unir los ids en un solo string separado por comas\r",
							"const neoIdsString = neoIds.join(',');\r",
							"\r",
							"// Validar que los ids se hayan extraído correctamente\r",
							"pm.test(\"Se extrajeron neo_reference_ids\", function () {\r",
							"    pm.expect(neoIdsString).to.not.be.empty;\r",
							"});\r",
							"\r",
							"// Guardar el string en una variable de entorno\r",
							"pm.environment.set('NEO_REFERENCE_IDS', neoIdsString);\r",
							"\r",
							"// Imprimir el resultado para verificación\r",
							"console.log(\"NEO Reference IDs: \", neoIdsString);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
